# OITERU 親機（本番標準）
# このファイルはテンプレートです。直接コピーせず、次のコマンドで導入してください。
#   sudo scripts/install_parent_service.sh
# 利用者名とリポジトリのパスは、導入時にスクリプトが実際の値へ置き換えます。
[Unit]
Description=OITERU Parent Server (MySQL)
After=network-online.target mysql.service oiteru-card-reader.service
Wants=network-online.target oiteru-card-reader.service
Requires=mysql.service

[Service]
Type=simple
User=@OITERU_USER@
WorkingDirectory=@OITERU_ROOT@
Environment=SERVER_PORT=5000
Environment=PYTHONUNBUFFERED=1
ExecStart=@OITERU_ROOT@/.venv/bin/gunicorn --config @OITERU_ROOT@/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oiteru-parent

[Install]
WantedBy=multi-user.target
