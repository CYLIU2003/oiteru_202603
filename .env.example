# ========================================
# OITERU サーバー設定ファイル (.env)
# ========================================
# このファイルをコピーして .env として使用してください
# 標準運用では、ローカル MySQL と systemd の親機サービスから参照します

# --- サーバー識別情報 ---
SERVER_NAME=OITERU親機
SERVER_LOCATION=本館1階

# --- Flask / 管理画面 ---
# ランダムな32文字以上の値を設定
FLASK_SECRET_KEY=change-this-secret-key

# 初回起動時の管理者パスワード
# 既定値は存在しないため、必ず変更してください
OITERU_ADMIN_USERNAME=administrator
OITERU_ADMIN_PASSWORD=change-this-admin-password
# カードUIDをDB保存前に疑似IDへ変換する専用キー（32文字以上のランダム値）
CARD_UID_HMAC_KEY=change-this-card-uid-hmac-key
CARD_UID_KEY_VERSION=1

ADMIN_SESSION_MINUTES=30
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_BLOCK_WINDOW_SECONDS=900
SESSION_COOKIE_SECURE=true
# 既定で true 扱い。HTTP のみの検証環境など、必要時のみ false に変更
OITERU_STRICT_SECURITY=true

# --- データベース設定 ---
# DB は MySQL 8 のみ（SQLite は廃止）。mysql 以外を書くと親機は起動しません。
DB_TYPE=mysql

# MySQL の接続先
# ローカル MySQL を使う場合は MYSQL_HOST=localhost のままにします
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=oiteru_user
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=oiteru

# --- スタンドアロンモード（親機停止中に子機だけで排出する） ---
# 詳しくは docs/operations.md の「スタンドアロンモード」
OITERU_OFFLINE_MODE=true
# 親機停止中に 1 枚のカードで出せる個数
OITERU_OFFLINE_PER_CARD_LIMIT=1
# 子機が持つ照合表の有効期限（時間）。これを過ぎると子機も排出を止める
OITERU_OFFLINE_CACHE_MAX_AGE_HOURS=72
# 子機に溜めてよい未送信の排出記録の上限
OITERU_OFFLINE_MAX_EVENTS=300

# --- 自動登録モード ---
# 未登録カードがタッチされた際に自動でユーザー登録する
# true: 一時的な登録作業時だけ有効化
# false: 標準。事前登録・承認が必要
AUTO_REGISTER_MODE=false

# 自動登録時の初期残数
# ユーザーが1日に取得できる生理用品の最大数
AUTO_REGISTER_STOCK=2
USAGE_LIMIT=2
LIMIT_PERIOD=day
